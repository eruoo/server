{
  "name": "eruoo-server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:release": "tsx scripts/build-release.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:client && pnpm run test:scripts && pnpm run openapi:check && pnpm run test:e2e",
    "db:restore:plan": "tsx scripts/restore-database.ts",
    "deploy:production": "tsx scripts/request-deployment.ts production",
    "deploy:staging": "tsx scripts/request-deployment.ts staging",
    "dev": "tsx scripts/dev.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "openapi:check": "tsx scripts/export-openapi.ts --check",
    "openapi:generate": "tsx scripts/export-openapi.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:e2e": "playwright test",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.scripts.json",
    "types:generate": "wrangler types --env staging --strict-vars false"
  },
  "dependencies": {
    "@ayingott/theme": "0.2.0",
    "@better-auth/api-key": "1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@better-auth/passkey": "1.7.2",
    "@hono/zod-openapi": "1.6.0",
    "@scalar/api-reference": "1.68.0",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.3",
    "jose": "6.2.12",
    "reka-ui": "2.10.3",
    "vue": "3.5.41",
    "vue-router": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260818.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "happy-dom": "20.11.2",
    "jsonc-parser": "3.3.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.10",
    "wrangler": "4.124.0"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
