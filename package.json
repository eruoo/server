{
  "name": "eruoo-server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "deploy:staging": "wrangler deploy --config wrangler.jsonc --env staging",
    "dev": "vite dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "types:generate": "wrangler types --env staging"
  },
  "dependencies": {
    "better-auth": "1.7.2",
    "hono": "4.13.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260818.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
