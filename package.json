{
  "name": "eruoo-server",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "api-types:generate": "openapi-typescript docs/openapi.json --output .generated/openapi.ts",
    "auth-schema:check": "tsx scripts/auth-schema.ts --check",
    "build": "pnpm run api-types:generate && CLOUDFLARE_ENV=production vite build && tsx scripts/sanitize-build.ts",
    "bundle:check": "wrangler deploy --config dist/eruoo_server/wrangler.json --env-file /dev/null --dry-run --no-x-provision --strict --outdir .wrangler/dry-run",
    "check": "pnpm run format:check && pnpm run lint && pnpm run secret:scan && pnpm run dependencies:audit && pnpm run types:check && pnpm run typecheck && pnpm run auth-schema:check && pnpm run test:config && pnpm run test && pnpm run test:integration && pnpm run test:e2e && pnpm run release:preflight",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:restore:plan": "tsx scripts/restore-database.ts",
    "dependencies:audit": "pnpm audit --prod",
    "deploy:production": "tsx scripts/deploy-production.ts",
    "dev": "pnpm run api-types:generate && vite",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "openapi:generate": "tsx scripts/openapi.ts --write",
    "prepare": "pnpm run api-types:generate && simple-git-hooks",
    "release:preflight": "pnpm run openapi:check && pnpm run build && tsx scripts/release-preflight.ts && pnpm run bundle:check && pnpm run startup:check",
    "secret:scan": "secretlint \"**/*\"",
    "secret:scan:staged": "tsx scripts/secret-scan-staged.ts",
    "startup:check": "wrangler check startup --config dist/eruoo_server/wrangler.json --env-file /dev/null --outfile .wrangler/worker-startup.cpuprofile",
    "test": "vitest run --config vitest.config.ts",
    "test:config": "vitest run --config vitest.node.config.ts",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.worker.config.ts",
    "typecheck": "pnpm run typecheck:client && pnpm run typecheck:worker && pnpm run typecheck:config && pnpm run typecheck:tests",
    "typecheck:client": "pnpm run api-types:generate && vue-tsc -p tsconfig.client.json --noEmit",
    "typecheck:config": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:tests": "vue-tsc -p tsconfig.test-client.json --noEmit && tsc -p tsconfig.test-worker.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "types:check": "wrangler types worker-configuration.d.ts --check",
    "types:generate": "wrangler types worker-configuration.d.ts"
  },
  "dependencies": {
    "@ayingott/theme": "0.2.0",
    "@better-auth/api-key": "1.7.0",
    "@better-auth/oauth-provider": "1.7.0",
    "@better-auth/passkey": "1.7.0",
    "@hono/zod-openapi": "1.6.0",
    "@lucide/vue": "1.31.0",
    "@scalar/api-reference": "1.65.1",
    "@scalar/hono-api-reference": "0.11.14",
    "better-auth": "1.7.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.3",
    "jose": "6.2.9",
    "openapi-fetch": "0.17.0",
    "reka-ui": "2.10.3",
    "vue": "3.5.41",
    "vue-router": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260818.1",
    "@playwright/test": "1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "happy-dom": "20.11.2",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "secretlint": "13.0.4",
    "simple-git-hooks": "2.13.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.10",
    "wrangler": "4.124.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run secret:scan:staged && pnpm run secret:scan && pnpm run format:check && pnpm run lint",
    "pre-push": "pnpm run check"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
