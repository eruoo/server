{
  "openapi": "3.1.0",
  "info": {
    "title": "eruoo API",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "ownerSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-eruoo.session_token"
      },
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "SecurityAuditEventPage": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SecurityAuditEvent"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "events",
          "nextCursor"
        ]
      },
      "SecurityAuditEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "api_key_created",
              "api_key_expired",
              "api_key_rejected",
              "api_key_revoked",
              "api_key_updated",
              "database_restore_completed",
              "github_login",
              "jwt_signing_key_rotated",
              "oauth_grant_created",
              "oauth_grant_revoked",
              "oauth_refresh_reuse_detected",
              "passkey_created",
              "passkey_deleted",
              "passkey_login",
              "passkey_updated",
              "security_configuration_changed",
              "sensitive_operation_denied"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "success",
              "failure"
            ]
          },
          "occurredAt": {
            "type": "integer"
          },
          "subjectId": {
            "type": [
              "string",
              "null"
            ]
          },
          "credentialId": {
            "type": [
              "string",
              "null"
            ]
          },
          "clientId": {
            "type": [
              "string",
              "null"
            ]
          },
          "ipFingerprint": {
            "type": [
              "string",
              "null"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "type",
          "outcome",
          "occurredAt",
          "subjectId",
          "credentialId",
          "clientId",
          "ipFingerprint",
          "requestId",
          "metadata"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "requestId"
        ]
      },
      "Status": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "DatabaseBackupStatus": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "errorCode": {
                "type": "null"
              },
              "lastAttemptAt": {
                "type": "null"
              },
              "lastSuccessAt": {
                "type": "null"
              },
              "status": {
                "type": "string",
                "enum": [
                  "never-run"
                ]
              }
            },
            "required": [
              "errorCode",
              "lastAttemptAt",
              "lastSuccessAt",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "errorCode": {
                "type": "null"
              },
              "lastAttemptAt": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8640000000000000,
                "description": "Unix epoch milliseconds.",
                "format": "int64"
              },
              "lastSuccessAt": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8640000000000000,
                "description": "Unix epoch milliseconds.",
                "format": "int64"
              },
              "status": {
                "type": "string",
                "enum": [
                  "ok"
                ]
              }
            },
            "required": [
              "errorCode",
              "lastAttemptAt",
              "lastSuccessAt",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "errorCode": {
                "type": "string",
                "enum": [
                  "backup_configuration_invalid",
                  "backup_concurrency_conflict",
                  "backup_lease_failed",
                  "backup_object_conflict",
                  "backup_schema_inventory_failed",
                  "backup_schema_inventory_invalid",
                  "backup_virtual_table_detected",
                  "backup_migration_state_invalid",
                  "backup_storage_inventory_failed",
                  "backup_storage_inventory_invalid",
                  "backup_storage_budget_exceeded",
                  "backup_export_authentication_failed",
                  "backup_export_request_failed",
                  "backup_export_response_invalid",
                  "backup_export_failed",
                  "backup_export_timed_out",
                  "backup_export_download_failed",
                  "backup_export_download_invalid",
                  "backup_compression_failed",
                  "backup_upload_timed_out",
                  "backup_upload_failed",
                  "backup_upload_abort_failed",
                  "backup_upload_integrity_failed",
                  "backup_health_write_failed"
                ]
              },
              "lastAttemptAt": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8640000000000000,
                "description": "Unix epoch milliseconds.",
                "format": "int64"
              },
              "lastSuccessAt": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 8640000000000000,
                "description": "Unix epoch milliseconds.",
                "format": "int64"
              },
              "status": {
                "type": "string",
                "enum": [
                  "failed"
                ]
              }
            },
            "required": [
              "errorCode",
              "lastAttemptAt",
              "lastSuccessAt",
              "status"
            ],
            "additionalProperties": false
          }
        ]
      },
      "OAuthAuthorization": {
        "type": "object",
        "properties": {
          "activeRefreshTokenCount": {
            "type": "integer",
            "minimum": 0
          },
          "authorized": {
            "type": "boolean"
          },
          "clientId": {
            "type": "string",
            "enum": [
              "eruoo-web",
              "eruoo-desktop",
              "eruoo-mobile"
            ]
          },
          "consentCount": {
            "type": "integer",
            "minimum": 0
          },
          "enabled": {
            "type": "boolean"
          },
          "lastAuthorizedAt": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Most recent authorization activity as Unix epoch milliseconds, or null when the application is not authorized.",
            "format": "int64"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "offlineAccess": {
            "type": "boolean"
          },
          "platform": {
            "type": "string",
            "enum": [
              "web",
              "desktop",
              "mobile"
            ]
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "https://auth.eruoo.me/api"
              ]
            }
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "openid",
                "profile",
                "api:read",
                "api:write",
                "offline_access"
              ]
            }
          },
          "supportsOfflineAccess": {
            "type": "boolean"
          }
        },
        "required": [
          "activeRefreshTokenCount",
          "authorized",
          "clientId",
          "consentCount",
          "enabled",
          "lastAuthorizedAt",
          "name",
          "offlineAccess",
          "platform",
          "resources",
          "scopes",
          "supportsOfflineAccess"
        ],
        "additionalProperties": false
      },
      "OAuthAuthorizationRevocation": {
        "type": "object",
        "properties": {
          "clientId": {
            "type": "string",
            "enum": [
              "eruoo-web",
              "eruoo-desktop",
              "eruoo-mobile"
            ]
          },
          "deletedConsentCount": {
            "type": "integer",
            "minimum": 0
          },
          "revokedRefreshTokenCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "clientId",
          "deletedConsentCount",
          "revokedRefreshTokenCount"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/security/audit-events": {
      "get": {
        "operationId": "listSecurityAuditEvents",
        "security": [
          {
            "ownerSession": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "api_key_created",
                "api_key_expired",
                "api_key_rejected",
                "api_key_revoked",
                "api_key_updated",
                "database_restore_completed",
                "github_login",
                "jwt_signing_key_rotated",
                "oauth_grant_created",
                "oauth_grant_revoked",
                "oauth_refresh_reuse_detected",
                "passkey_created",
                "passkey_deleted",
                "passkey_login",
                "passkey_updated",
                "security_configuration_changed",
                "sensitive_operation_denied"
              ]
            },
            "required": false,
            "name": "type",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "success",
                "failure"
              ]
            },
            "required": false,
            "name": "outcome",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "required": false,
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "required": false,
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Security events in descending keyset order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecurityAuditEventPage"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or dependency unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "operationId": "getStatus",
        "security": [
          {
            "ownerSession": []
          },
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated service status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or dependency unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/security/backup-status": {
      "get": {
        "operationId": "getDatabaseBackupStatus",
        "security": [
          {
            "ownerSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Latest durable backup health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseBackupStatus"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or dependency unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/oauth/authorizations": {
      "get": {
        "operationId": "listOAuthAuthorizations",
        "security": [
          {
            "ownerSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Static application authorizations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OAuthAuthorization"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or dependency unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/oauth/authorizations/{clientId}": {
      "delete": {
        "operationId": "revokeOAuthAuthorization",
        "security": [
          {
            "ownerSession": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "clientId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Revoked offline authorization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthAuthorizationRevocation"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or dependency unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
