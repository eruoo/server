{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "eruoo-server-v2",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "env": {
    "staging": {
      "name": "eruoo-server-staging",
      "vars": {
        "APP_ORIGIN": "https://eruoo-server-staging.l709937065.workers.dev",
        "OWNER_GITHUB_ID": "50254496",
        "CF_ACCOUNT_ID": "1d204c847b5870d3438dc79534b91798",
        "D1_DATABASE_ID": "f34c1033-7474-4af6-9e76-d7930eb63111",
      },
      "workers_dev": true,
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.01,
        },
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "eruoo-server-staging",
          "database_id": "f34c1033-7474-4af6-9e76-d7930eb63111",
        },
      ],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
        {
          "name": "API_KEY_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
        {
          "name": "AI_RATE_LIMITER",
          "namespace_id": "1005",
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
      ],
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRETS",
          "GITHUB_CLIENT_ID",
          "GITHUB_CLIENT_SECRET",
          "AUDIT_IP_HASH_SECRET",
          "D1_EXPORT_API_TOKEN",
          "AI_CREDENTIAL_KEYS",
        ],
      },
      "triggers": {
        "crons": ["0 20 * * *", "0 19 * * *"],
      },
      "r2_buckets": [
        {
          "binding": "BACKUPS",
          "bucket_name": "eruoo-server-backups-staging",
        },
      ],
      "workflows": [
        {
          "binding": "DATABASE_BACKUP_WORKFLOW",
          "name": "eruoo-database-backup-staging",
          "class_name": "DatabaseBackupWorkflow",
        },
      ],
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*",
          "/.well-known/*",
          "/problems/*",
          "/health",
        ],
      },
    },
    "production": {
      "name": "eruoo-server-production",
      "workers_dev": false,
      "vars": {
        "APP_ORIGIN": "https://auth.eruoo.me",
        "OWNER_GITHUB_ID": "50254496",
        "CF_ACCOUNT_ID": "1d204c847b5870d3438dc79534b91798",
        "D1_DATABASE_ID": "a4385433-9ddd-4a2b-a7ce-863884287e38",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "eruoo-server",
          "database_id": "a4385433-9ddd-4a2b-a7ce-863884287e38",
        },
      ],
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
        {
          "name": "API_KEY_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
        {
          "name": "AI_RATE_LIMITER",
          "namespace_id": "1006",
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
      ],
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.01,
        },
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRETS",
          "GITHUB_CLIENT_ID",
          "GITHUB_CLIENT_SECRET",
          "AUDIT_IP_HASH_SECRET",
          "D1_EXPORT_API_TOKEN",
          "AI_CREDENTIAL_KEYS",
        ],
      },
      "triggers": {
        "crons": ["0 20 * * *", "0 19 * * *"],
      },
      "r2_buckets": [
        {
          "binding": "BACKUPS",
          "bucket_name": "eruoo-server-backups",
        },
      ],
      "workflows": [
        {
          "binding": "DATABASE_BACKUP_WORKFLOW",
          "name": "eruoo-database-backup",
          "class_name": "DatabaseBackupWorkflow",
        },
      ],
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*",
          "/.well-known/*",
          "/problems/*",
          "/health",
        ],
      },
    },
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:5173",
    "OWNER_GITHUB_ID": "50254496",
    "CF_ACCOUNT_ID": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
    "D1_DATABASE_ID": "00000000-0000-0000-0000-000000000000",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eruoo-server-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "API_KEY_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1007",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*", "/problems/*", "/health"],
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRETS",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "AUDIT_IP_HASH_SECRET",
      "D1_EXPORT_API_TOKEN",
      "AI_CREDENTIAL_KEYS",
    ],
  },
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "eruoo-server-backups-v2-local",
    },
  ],
  "workflows": [
    {
      "binding": "DATABASE_BACKUP_WORKFLOW",
      "name": "eruoo-server-backup-v2-local",
      "class_name": "DatabaseBackupWorkflow",
    },
  ],
}
